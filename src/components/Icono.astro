};

const trazo = TRAZOS[nombre] ?? "";
const solido = SOLIDOS[nombre] ?? "";
if (!trazo && !solido && import.meta.env.DEV) {
  console.warn(`[Icono] no existe "${nombre}". Iconos: ${Object.keys(TRAZOS).join(", ")}`);
}
---

{solido ? (
  <svg
    width={tamano}
    height={tamano}
    viewBox="0 0 24 24"
    fill="currentColor"
    class={clase}
    aria-hidden="true"
    set:html={solido}
  />
) : (
  <svg
    width={tamano}
    height={tamano}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={grosor}
    stroke-linecap="round"
    stroke-linejoin="round"
    class={clase}
    aria-hidden="true"
    set:html={trazo}
  />
)}
