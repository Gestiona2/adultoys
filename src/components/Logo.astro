---
/**
 * El logo de Adultoyss.
 *
 * `clara` es la version para fondos oscuros (la del sitio).
 * `normal` es la version original para fondos claros (documentos, Excel).
 */
interface Props {
  alto?: number;
  variante?: "clara" | "normal";
  clase?: string;
}
const { alto = 46, variante = "clara", clase = "" } = Astro.props;
const base = import.meta.env.BASE_URL;
const src = `${base}img/marca/logo-adultoyss${variante === "clara" ? "-claro" : ""}.png`.replace(/\/{2,}/g, "/");
// Proporcion del logo ya recortado (321 x 126 px).
const ancho = Math.round((alto * 321) / 126);
---

<img
  src={src}
  alt="Adultoyss, tienda erótica"
  width={ancho}
  height={alto}
  class:list={["logo", clase]}
  decoding="async"
/>
