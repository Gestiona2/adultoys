---
/**
 * Tarjeta de un articulo del blog.
 */
import Foto from "./Foto.astro";
import Icono from "./Icono.astro";

interface Props { post: any; }
const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const url = `${base}blog/${post.slug}`.replace(/\/{2,}/g, "/");
---

<article class="blog-tarjeta">
  <a class="blog-tarjeta-foto" href={url} tabindex="-1" aria-hidden="true">
    <Foto nombre={post.imagen} alt={post.imagen_alt} sizes="(max-width: 760px) 92vw, 380px" />
    <span class="blog-tarjeta-etiqueta">{post.etiqueta}</span>
  </a>
  <div class="blog-tarjeta-cuerpo">
    <p class="blog-tarjeta-meta">{post.lectura} min de lectura</p>
    <h3><a href={url}>{post.titulo}</a></h3>
    <p class="blog-tarjeta-extracto">{post.extracto}</p>
    <a class="blog-tarjeta-enlace" href={url}>
      Leer la guía <Icono nombre="flecha" tamano={16} />
    </a>
  </div>
</article>
