---
/**
 * Carrusel de la portada: las piezas rotan solas cada seis segundos. Los
 * controles van sobre la foto (flechas, puntos con barra de progreso y pausa)
 * para que se vean sin bajar. Se detiene al enfocar con el teclado o con el
 * boton de pausa, y en celular se puede deslizar con el dedo.
 *
 * La primera pieza dice que es Adultoyss y que ofrece. Las demas llevan a
 * una categoria concreta. El contenido sale de src/datos/home.json.
 */
import home from "../datos/home.json";
import config from "../datos/config.json";
import Icono from "./Icono.astro";
import Foto from "./Foto.astro";
import DecoHalloween from "./DecoHalloween.astro";

const base = import.meta.env.BASE_URL;
const textos = home.carrusel;
const halloween = config.tema_estacional === "halloween";
const luna = `${base}img/halloween/luna.svg`.replace(/\/{2,}/g, "/");
const enlace = (r: string) =>
  r === "whatsapp"
    ? `https://wa.me/${config.whatsapp}`
    : `${base}${r}`.replace(/\/{2,}/g, "/");
---

<section class="carrusel" id="carrusel" aria-roledescription="carrusel" aria-label="Bienvenida">
  <div class="carrusel-pista">
    {home.banners.map((banner, indice) => (
      <article
        class:list={["carrusel-pieza", { activa: indice === 0 }]}
        role="group"
        aria-roledescription="diapositiva"
        aria-label={`${indice + 1} de ${home.banners.length}`}
        aria-hidden={indice !== 0}
      >
        <div class="carrusel-texto">
          <span class="carrusel-etiqueta">
            <Icono nombre="brillo" tamano={14} />
            {banner.etiqueta}
          </span>
          {indice === 0 ? <h1>{banner.titulo}</h1> : <h2>{banner.titulo}</h2>}
          <p>{banner.texto}</p>
          <div class="carrusel-acciones">
            <a
              class="boton boton-primario"
              href={enlace(banner.enlace)}
              {...(banner.enlace === "whatsapp" ? { target: "_blank", rel: "noopener" } : {})}
            >
              {banner.enlace === "whatsapp" && <Icono nombre="whatsapp" tamano={18} />}
              {banner.boton}
              <Icono nombre="flecha" tamano={17} />
            </a>
            <a class="boton boton-fantasma" href={enlace("nosotros")}>Conócenos</a>
          </div>
          <ul class="carrusel-sellos">
            <li><Icono nombre="discreto" tamano={15} /> Discreción total</li>
            <li><Icono nombre="camion" tamano={15} /> Envío nacional</li>
            <li><Icono nombre="pago" tamano={15} /> Contraentrega</li>
          </ul>
        </div>

        <div class="carrusel-visual">
          {halloween && <img class="hw-luna" src={luna} alt="" aria-hidden="true" width="220" height="220" />}
          <span class="carrusel-halo" aria-hidden="true"></span>
          <span class="carrusel-marco" aria-hidden="true"></span>
          <div class="carrusel-foto">
            <Foto
              nombre={banner.foto}
              alt={banner.foto_alt}
              sizes="(max-width: 900px) 92vw, 520px"
              prioridad={indice === 0}
            />
            <div class="carrusel-control">
              <button type="button" class="carrusel-flecha carrusel-flecha-atras" data-mover="-1" aria-label={textos.anterior}>
                <Icono nombre="flecha" tamano={16} />
              </button>
              <div class="carrusel-puntos">
                {home.banners.map((otro, j) => (
                  <button
                    type="button"
                    class:list={["carrusel-punto", { activo: j === indice }]}
                    data-ir={j}
                    aria-label={`${textos.ir_a}: ${otro.etiqueta.toLowerCase()}`}
                    aria-current={j === indice ? "true" : undefined}
                  ></button>
                ))}
              </div>
              <button type="button" class="carrusel-flecha" data-mover="1" aria-label={textos.siguiente}>
                <Icono nombre="flecha" tamano={16} />
              </button>
              <button
                type="button"
                class="carrusel-pausa"
                aria-pressed="false"
                aria-label={textos.pausar}
                data-pausar={textos.pausar}
                data-reanudar={textos.reanudar}
              >
                <svg class="icono-pausa" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg>
                <svg class="icono-play" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
              </button>
            </div>
          </div>
          <span class="carrusel-flotante carrusel-flotante-arriba">
            <Icono nombre="estrella" tamano={15} />
            Selección Adultoyss
          </span>
          <span class="carrusel-flotante carrusel-flotante-abajo">
            <Icono nombre="regalo" tamano={15} />
            Listo para regalar
          </span>
        </div>
      </article>
    ))}
  </div>
  <DecoHalloween zona="hero" />
</section>
