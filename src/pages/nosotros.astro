---
/**
 * Nosotros: quiénes somos y cómo trabajamos. El texto vive en
 * src/datos/nosotros.json.
 */
import Tienda from "../layouts/Tienda.astro";
import Foto from "../components/Foto.astro";
import Icono from "../components/Icono.astro";
import nosotros from "../datos/nosotros.json";
import config from "../datos/config.json";

const base = import.meta.env.BASE_URL;
const enlace = (r: string) => `${base}${r}`.replace(/\/{2,}/g, "/");
---

<Tienda
  titulo="Nosotros"
  descripcion="Conoce Adultoyss, la tienda erótica de Tocancipá que habla de placer sin juicios y con discreción."
  activa="nosotros"
>
  <div class="container">
    <header class="pagina-hero">
      <p class="seccion-etiqueta"><Icono nombre="corazon" tamano={14} /> Quiénes somos</p>
      <h1>{nosotros.titulo}</h1>
      <p class="pagina-hero-entrada">{nosotros.entrada}</p>
    </header>

    <div class="nosotros-grid">
      <div class="nosotros-foto">
        <Foto nombre={nosotros.foto_principal.foto} alt={nosotros.foto_principal.foto_alt} sizes="(max-width: 900px) 92vw, 560px" prioridad />
        <p class="nosotros-pie">{nosotros.foto_principal.pie}</p>
      </div>
      <div class="nosotros-texto">
        <h2>Por qué existimos</h2>
        <p>{nosotros.proposito}</p>
        <div class="nosotros-bloques">
          {nosotros.bloques.map((bloque) => (
            <article>
              <h3>{bloque.titulo}</h3>
              <p>{bloque.texto}</p>
            </article>
          ))}
        </div>
        <a class="boton boton-primario" href={enlace("catalogo")}>Explorar el catálogo <Icono nombre="flecha" tamano={16} /></a>
      </div>
    </div>

    <section class="nosotros-valores">
      <div class="nosotros-valores-texto">
        <p class="seccion-etiqueta"><Icono nombre="escudo" tamano={14} /> Lo que nos guía</p>
        <h2>Cinco reglas que no negociamos</h2>
      </div>
      <ul class="valores-lista">
        {nosotros.valores.map((valor, indice) => (
          <li>
            <span>{String(indice + 1).padStart(2, "0")}</span>
            {valor}
          </li>
        ))}
      </ul>
    </section>

    <div class="cierre">
      <span class="cierre-halo" aria-hidden="true"></span>
      <div>
        <h2>¿Hablamos?</h2>
        <p>Estamos en {config.ciudad} y atendemos por WhatsApp. Sin compromiso y sin juicios.</p>
      </div>
      <a class="boton boton-primario" href={`https://wa.me/${config.whatsapp}`} target="_blank" rel="noopener">
        <Icono nombre="whatsapp" tamano={18} /> Escribir ahora
      </a>
    </div>
  </div>
</Tienda>
