---
/**
 * Páginas legales: privacidad, tratamiento de datos, términos y envíos.
 *
 * Todo el texto vive en src/datos/legal.json. Una página por cada llave.
 */
import Tienda from "../../layouts/Tienda.astro";
import Icono from "../../components/Icono.astro";
import legal from "../../datos/legal.json";
import config from "../../datos/config.json";

export function getStaticPaths() {
  const docs = Object.entries(legal).filter(
    ([clave]) => !clave.startsWith("_") && clave !== "actualizado"
  ) as [string, { titulo: string; entrada: string; secciones: { titulo: string; texto: string }[] }][];

  return docs.map(([tipo, documento]) => ({
    params: { tipo },
    props: { tipo, documento },
  }));
}

const documentos = Object.entries(legal).filter(
  ([clave]) => !clave.startsWith("_") && clave !== "actualizado"
) as [string, { titulo: string; entrada: string; secciones: { titulo: string; texto: string }[] }][];

const { tipo, documento } = Astro.props;
const base = import.meta.env.BASE_URL;
const enlace = (r: string) => `${base}${r}`.replace(/\/{2,}/g, "/");
const fecha = new Date(`${legal.actualizado}T12:00:00`).toLocaleDateString("es-CO", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const otros = documentos.filter(([clave]) => clave !== tipo);
---

<Tienda
  titulo={documento.titulo}
  descripcion={documento.entrada}
  activa="legal"
>
  <div class="container">
    <nav class="migas" aria-label="Ruta de navegación">
      <a href={enlace("")}>Inicio</a> <span aria-hidden="true">›</span>
      <span class="migas-actual">{documento.titulo}</span>
    </nav>

    <div class="legal">
      <aside class="legal-indice">
        <p class="legal-indice-titulo">Documentos legales</p>
        <nav aria-label="Documentos legales">
          {documentos.map(([clave, doc]) => (
            <a href={enlace(`legal/${clave}`)} class:list={{ activo: clave === tipo }}>
              {doc.titulo}
            </a>
          ))}
        </nav>
        <div class="legal-ayuda">
          <Icono nombre="whatsapp" tamano={20} />
          <p>¿Tienes una duda sobre tus datos o tu pedido?</p>
          <a href={`https://wa.me/${config.whatsapp}`} target="_blank" rel="noopener">Escríbenos</a>
        </div>
      </aside>

      <article class="legal-documento">
        <header>
          <p class="seccion-etiqueta"><Icono nombre="escudo" tamano={14} /> Información legal</p>
          <h1>{documento.titulo}</h1>
          <p class="legal-entrada">{documento.entrada}</p>
          <p class="legal-fecha">Última actualización: {fecha}</p>
        </header>

        {documento.secciones.map((seccion, indice) => (
          <section>
            <h2><span>{String(indice + 1).padStart(2, "0")}</span>{seccion.titulo}</h2>
            <p>{seccion.texto}</p>
          </section>
        ))}

        <footer class="legal-pie">
          <p>
            Adultoyss · {config.direccion} · <a href={`mailto:${config.correo}`}>{config.correo}</a> ·
            WhatsApp <a href={`https://wa.me/${config.whatsapp}`}>{config.whatsapp_visible}</a>
          </p>
          <p>
            {tipo === "envios" && "Esta política aplica a todos los pedidos despachados por Adultoyss."}
            {tipo !== "envios" && "Este documento puede actualizarse; la versión vigente es la publicada en esta página."}
          </p>
        </footer>

        <nav class="legal-otros" aria-label="Otros documentos">
          {otros.map(([clave, doc]) => (
            <a href={enlace(`legal/${clave}`)}>{doc.titulo} <Icono nombre="flecha" tamano={15} /></a>
          ))}
        </nav>
      </article>
    </div>
  </div>
</Tienda>
