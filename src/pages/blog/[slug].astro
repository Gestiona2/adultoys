---
/**
 * Un artículo del blog. El contenido vive en src/datos/blog.json y se escribe
 * como una lista de bloques (párrafo, subtítulo o lista).
 */
import Tienda from "../../layouts/Tienda.astro";
import GrillaProductos from "../../components/GrillaProductos.astro";
import Icono from "../../components/Icono.astro";
import Foto from "../../components/Foto.astro";
import blog from "../../datos/blog.json";
import productos from "../../datos/productos.json";
import config from "../../datos/config.json";

export function getStaticPaths() {
  return blog.posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const enlace = (r: string) => `${base}${r}`.replace(/\/{2,}/g, "/");

const fecha = new Date(`${post.fecha}T12:00:00`).toLocaleDateString("es-CO", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const relacionados = (post.relacionados ?? [])
  .map((slug: string) => productos.find((p) => p.slug === slug && !p.oculto))
  .filter(Boolean);

const otros = blog.posts.filter((p) => p.slug !== post.slug).slice(0, 3);
---

<Tienda
  titulo={post.titulo}
  descripcion={post.extracto}
  activa="blog"
  imagen={`${base}img/${post.imagen}-900.webp`.replace(/\/{2,}/g, "/")}
>
  <div class="container">
    <nav class="migas" aria-label="Ruta de navegación">
      <a href={enlace("")}>Inicio</a> <span aria-hidden="true">›</span>
      <a href={enlace("blog")}>Blog</a> <span aria-hidden="true">›</span>
      <span class="migas-actual">{post.titulo}</span>
    </nav>

    <article class="post">
      <header class="post-cabeza">
        <p class="seccion-etiqueta"><Icono nombre="hoja" tamano={14} /> {post.etiqueta}</p>
        <h1>{post.titulo}</h1>
        <p class="post-meta">{fecha} · {post.lectura} min de lectura</p>
        <p class="post-extracto">{post.extracto}</p>
      </header>

      <div class="post-foto">
        <Foto nombre={post.imagen} alt={post.imagen_alt} sizes="(max-width: 900px) 92vw, 900px" prioridad />
      </div>

      <div class="post-cuerpo">
        {post.contenido.map((bloque: any) => {
          if (bloque.tipo === "h2") return <h2>{bloque.texto}</h2>;
          if (bloque.tipo === "ul") return (
            <ul>
              {bloque.items.map((item: string) => <li>{item}</li>)}
            </ul>
          );
          return <p>{bloque.texto}</p>;
        })}
      </div>

      <aside class="post-aviso">
        <Icono nombre="escudo" tamano={22} />
        <p>
          Esta guía es informativa y no reemplaza la consulta con un profesional de la
          salud. Si algo te duele o te preocupa, busca acompañamiento médico.
        </p>
      </aside>

      <div class="post-cierre">
        <div>
          <h2>¿Te ayudamos a elegir?</h2>
          <p>Escríbenos por WhatsApp y te recomendamos según lo que buscas.</p>
        </div>
        <a class="boton boton-primario" href={`https://wa.me/${config.whatsapp}`} target="_blank" rel="noopener">
          <Icono nombre="whatsapp" tamano={18} /> Preguntar
        </a>
      </div>
    </article>

    {relacionados.length > 0 && (
      <section class="seccion">
        <header class="seccion-cabeza">
          <div>
            <p class="seccion-etiqueta">Mencionados en la guía</p>
            <h2>Productos relacionados</h2>
          </div>
        </header>
        <GrillaProductos productos={relacionados} />
      </section>
    )}

    <section class="seccion">
      <header class="seccion-cabeza">
        <div>
          <p class="seccion-etiqueta">Sigue leyendo</p>
          <h2>Otras guías</h2>
        </div>
        <a class="seccion-enlace" href={enlace("blog")}>Ver todas <Icono nombre="flecha" tamano={16} /></a>
      </header>
      <div class="blog-mini">
        {otros.map((otro) => (
          <a class="blog-mini-item" href={enlace(`blog/${otro.slug}`)}>
            <span>{otro.etiqueta}</span>
            <strong>{otro.titulo}</strong>
            <small>{otro.lectura} min de lectura</small>
          </a>
        ))}
      </div>
    </section>
  </div>
</Tienda>
